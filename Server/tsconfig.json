{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "paths": {
      "@modules/*": ["./src/module/*"],
      "@middleware/*": ["./src/Middleware/*"],
      "@utils/*": ["./src/utils/*"],
      "@config/*": ["./src/config/*"],
      "@api/*": ["./src/api/*"]
    },

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },

  "include": ["src"]
}